{
  "name": "mvcs-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Masaka VC System",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "cleanup:seeded-data": "node scripts/cleanup-seeded-data.js",
    "cleanup:all-except-account": "node scripts/cleanup-all-except-account.js",
    "import:players": "node scripts/import-players-to-account.js",
    "set:imported-players-contribution": "node scripts/set-imported-players-contribution.js",
    "promote:super-admin": "node scripts/promote-to-super-admin.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:create": "sequelize-cli migration:generate --name"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.2",
    "node-cron": "^4.2.1",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.3"
  }
}
